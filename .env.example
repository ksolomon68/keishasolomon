# Copy to .env.local and fill in. Never commit real values.
DATA_BACKEND=mysql            # "mysql" (production) | "file" (local dev only)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
SESSION_SECRET=               # >= 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COHORT_ACCESS_CODE=           # optional: keeps this code on the "Founding cohort" when db:migrate upgrades an old database. Cohort codes are managed in /admin.
UPLOAD_DIR=./storage
NEXT_PUBLIC_CONTACT_EMAIL=   # public instructor/support email shown on the site
NEXT_PUBLIC_SITE_URL=https://evobrandacademy.com # canonical public URL; no trailing slash
NEXT_PUBLIC_COACHING_BOOKING_URL= # optional public scheduling page for remote 1:1 coaching
NEXT_PUBLIC_GOOGLE_MEET_URL=      # optional standing Google Meet room; omit to show it after confirmation

# Outbound Email (SMTP) - used to send welcome credentials to manually added users
SMTP_HOST=mail.evobrand.net      # Your SMTP mail server hostname
SMTP_PORT=465                    # 465 (SSL) or 587 (TLS)
SMTP_SECURE=true                 # true for 465, false for 587
SMTP_USER=info@evobrand.net      # Email username
SMTP_PASS=                       # Email account password
SMTP_FROM="The AI Executive Sandbox <info@evobrand.net>"

# Optional isolated directory for local file-backend testing (not used by MySQL):
# LOCAL_DATA_DIR=./.data/cohort-browser-test
